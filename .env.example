# Default local development uses SQLite when DATABASE_URL is not set.
# Docker Compose configures DATABASE_URL automatically.

# MySQL configuration for Docker Compose
MYSQL_DATABASE=quizmaster
MYSQL_USER=quizmaster

# Replace these with strong, randomly generated passwords.
MYSQL_PASSWORD=replace_with_a_secure_password
MYSQL_ROOT_PASSWORD=replace_with_another_secure_password

# Flask debug mode (0 = disabled, 1 = enabled)
FLASK_DEBUG=0
